generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  status        String   @default("Active")
  licenseStatus String   @default("Trial")
  logoUrl       String?
  adminName     String?
  adminEmail    String?
  adminPhone    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users        User[]
  auditLogs    AuditLog[]
  projects     Project[]
  products     Product[]
  requirements Requirement[]
  testPlans    TestPlan[]
  testCases    TestCase[]
  testSuites   TestSuite[]
  testExecutions TestExecution[]
  defects      Defect[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  fullName       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  roles                UserRole[]
  auditLogs            AuditLog[]
  refreshTokens        RefreshToken[]
  managedProjects      Project[]     @relation("ProjectManager")
  ownedProducts        Product[]     @relation("ProductOwner")
  authoredRequirements Requirement[] @relation("RequirementAuthor")
  approvedRequirements Requirement[] @relation("RequirementApprover")
  authoredTestPlans    TestPlan[]    @relation("TestPlanAuthor")
  approvedTestPlans    TestPlan[]    @relation("TestPlanApprover")
  authoredTestCases    TestCase[]    @relation("TestCaseAuthor")
  approvedTestCases    TestCase[]    @relation("TestCaseApprover")
  authoredTestSuites   TestSuite[]   @relation("TestSuiteAuthor")
  executedTests        TestExecution[] @relation("TestExecutionExecutor")
  reportedDefects      Defect[]      @relation("DefectReporter")
  assignedDefects      Defect[]      @relation("DefectAssignee")
  resolvedDefects      Defect[]      @relation("DefectResolver")

  @@index([organizationId, createdAt])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// Persisted so refresh tokens can be revoked/rotated on logout or reuse detection,
// instead of relying on a stateless JWT that stays valid until it expires.
model RefreshToken {
  id        String    @id @default(uuid())
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  code        String
  description String?
  status      String    @default("Active")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  projectManagerId String?
  projectManager   User?   @relation("ProjectManager", fields: [projectManagerId], references: [id])

  requirements Requirement[]
  testPlans    TestPlan[]
  testCases    TestCase[]
  testSuites   TestSuite[]
  testExecutions TestExecution[]
  defects      Defect[]

  @@unique([organizationId, code])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  code        String
  description String?
  version     String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  productOwnerId String?
  productOwner   User?   @relation("ProductOwner", fields: [productOwnerId], references: [id])

  @@unique([organizationId, code])
}

model Requirement {
  id          String   @id @default(cuid())
  title       String
  code        String
  description String?
  type        String   @default("Functional")
  priority    String   @default("Medium")
  status      String   @default("Draft")
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  createdById String?
  createdBy   User?   @relation("RequirementAuthor", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("RequirementApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  testCases TestCase[]
  defects   Defect[]

  @@unique([projectId, code])
  @@index([organizationId, createdAt])
}

model TestPlan {
  id             String    @id @default(cuid())
  title          String
  code           String
  description    String?
  scope          String?
  strategy       String?
  entryCriteria  String?
  exitCriteria   String?
  environment    String?
  releaseVersion String?
  status         String    @default("Draft")
  version        Int       @default(1)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  createdById String?
  createdBy   User?   @relation("TestPlanAuthor", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("TestPlanApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  executions TestExecution[]

  @@unique([projectId, code])
  @@index([organizationId, createdAt])
}

model TestCase {
  id             String    @id @default(cuid())
  title          String
  code           String
  description    String?
  preconditions  String?
  steps          String?
  expectedResult String?
  testData       String?
  type           String    @default("Functional")
  priority       String    @default("Medium")
  risk           String    @default("Medium")
  tags           String?
  status         String    @default("Draft")
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  createdById String?
  createdBy   User?   @relation("TestCaseAuthor", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("TestCaseApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  // Optional — which requirement this case verifies. Powers the traceability
  // matrix in Reports & Analytics; not every case traces to one.
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id])

  testSuites TestSuite[] @relation("TestSuiteCases")
  executions TestExecution[]

  @@unique([projectId, code])
  @@index([organizationId, createdAt])
}

model TestSuite {
  id          String   @id @default(cuid())
  name        String
  code        String
  description String?
  type        String   @default("Regression")
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  createdById String?
  createdBy   User?   @relation("TestSuiteAuthor", fields: [createdById], references: [id])

  testCases TestCase[] @relation("TestSuiteCases")
  executions TestExecution[]

  @@unique([projectId, code])
  @@index([organizationId, createdAt])
}

model TestExecution {
  id           String    @id @default(cuid())
  code         String
  cycle        String?
  result       String    @default("Not Run")
  actualResult String?
  notes        String?
  environment  String?
  executedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id])

  testPlanId String?
  testPlan   TestPlan? @relation(fields: [testPlanId], references: [id])

  testSuiteId String?
  testSuite   TestSuite? @relation(fields: [testSuiteId], references: [id])

  executedById String?
  executedBy   User?   @relation("TestExecutionExecutor", fields: [executedById], references: [id])

  defects Defect[]

  @@unique([projectId, code])
  @@index([organizationId, createdAt])
}

model Defect {
  id               String    @id @default(cuid())
  title            String
  code             String
  description      String?
  stepsToReproduce String?
  severity         String    @default("Medium")
  priority         String    @default("Medium")
  status           String    @default("New")
  environment      String?
  resolution       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  // Optional — the failed (or otherwise notable) execution that raised this
  // defect. Not every defect starts from a logged execution.
  testExecutionId String?
  testExecution   TestExecution? @relation(fields: [testExecutionId], references: [id])

  // Optional — the requirement this defect ultimately puts at risk.
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id])

  reportedById String?
  reportedBy   User?   @relation("DefectReporter", fields: [reportedById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("DefectAssignee", fields: [assignedToId], references: [id])

  resolvedById String?
  resolvedBy   User?     @relation("DefectResolver", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?

  @@unique([projectId, code])
  @@index([organizationId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  // Nullable + SetNull: an audit entry must outlive the organization it
  // happened in, not block that organization's deletion.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
}
